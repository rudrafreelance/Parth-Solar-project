# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public site URL for SEO canonical/OG tags (Vercel domain)
VITE_SITE_URL=https://your-domain.vercel.app

# Google Analytics 4 + Google Ads conversion (optional; thank-you page)
# Guide: docs/google-ads-lead-automation.md
VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
VITE_GOOGLE_ADS_ID=AW-XXXXXXXX
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Meta WhatsApp Cloud API (server-only — never expose as VITE_*)
# Setup guide: docs/whatsapp-cloud-api.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=918003080020

# Optional but recommended in production (approved Meta template)
# Template body example: New website chat from {{1}}. Phone: {{2}}. Message: {{3}}
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Admin email alerts via Resend (https://resend.com — free tier)
# On "Get my estimate" + every lead submit, admin gets an email.
RESEND_API_KEY=re_xxxxxxxx
ADMIN_EMAIL=you@yourdomain.com
EMAIL_FROM=Ideal Energy <onboarding@resend.dev>
